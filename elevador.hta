<!DOCTYPE html>
<html>
<head>
    <title>Simulador de Elevador Residencial</title>
    <meta http-equiv="X-UA-Compatible" content="IE=9">
    <hta:application 
        id="oElevadorResidencial"
        applicationname="SimuladorElevadorCasa"
        border="thin"
        caption="yes"
        showintaskbar="yes"
        singleinstance="yes"
        sysmenu="yes"
        windowstate="normal"
        scroll="no"
    >
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #2c3e50;
            color: #ecf0f1;
            margin: 0;
            padding: 20px;
            user-select: none;
        }
        .container {
            display: flex;
            width: 700px;
            height: 480px;
            background-color: #34495e;
            border: 4px solid #1a252f;
            border-radius: 10px;
            padding: 15px;
            box-shadow: 0px 10px 20px rgba(0,0,0,0.5);
        }
        /* Painel de Controlo */
        .painel {
            width: 200px;
            background-color: #22313f;
            border: 2px solid #1e272e;
            border-radius: 8px;
            padding: 15px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 93%;
        }
        .visor {
            width: 100%;
            height: 60px;
            background-color: #000;
            border: 2px solid #7f8c8d;
            border-radius: 5px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-family: 'Courier New', Courier, monospace;
            color: #2ecc71;
            font-weight: bold;
            text-shadow: 0 0 10px #2ecc71;
        }
        .botoes-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            width: 100%;
        }
        .btn-andar {
            height: 50px;
            font-size: 18px;
            font-weight: bold;
            background-color: #bdc3c7;
            color: #2c3e50;
            border: none;
            border-radius: 50%;
            cursor: pointer;
            box-shadow: 0 4px #95a5a6;
            outline: none;
        }
        .btn-andar:active {
            box-shadow: 0 1px #95a5a6;
            transform: translateY(3px);
        }
        .btn-andar.chamado {
            background-color: #e67e22;
            color: #fff;
            box-shadow: 0 4px #d35400;
        }

        /* A ESTRUTURA DA CASA */
        .cenario {
            flex: 1;
            margin-left: 20px;
            position: relative;
            background-color: #a5d6a7; /* Cor do fundo / céu/jardim */
            border-radius: 8px;
            overflow: hidden;
            border: 2px solid #27ae60;
        }
        .telhado {
            position: absolute;
            top: 10px;
            left: 50px;
            width: 0;
            height: 0;
            border-left: 175px solid transparent;
            border-right: 175px solid transparent;
            border-bottom: 50px solid #c0392b;
            z-index: 5;
        }
        .casa {
            position: absolute;
            top: 60px;
            left: 65px;
            width: 320px;
            height: 400px;
            background-color: #f1c40f; /* Paredes exteriores da casa */
            border: 4px solid #d35400;
            border-bottom: none;
            box-sizing: border-box;
        }
        
        /* Divisões e Andares da Casa */
        .divisao-andar {
            position: absolute;
            width: 100%;
            height: 99px;
            border-bottom: 3px solid #d35400;
            box-sizing: border-box;
            padding-left: 15px;
            padding-top: 5px;
            font-size: 12px;
            font-weight: bold;
            color: #d35400;
            font-family: Arial, sans-serif;
        }
        
        /* O Poço do Elevador (Janelas de Vidro Alinhadas) */
        .coluna-elevador {
            position: absolute;
            right: 30px;
            top: 0px;
            width: 90px;
            height: 100%;
            background-color: #34495e;
            border-left: 3px solid #d35400;
            border-right: 3px solid #d35400;
            box-sizing: border-box;
        }

        /* Janelas por onde se vê o elevador passar */
        .janela-elevador {
            position: absolute;
            width: 70px;
            height: 75px;
            background-color: rgba(52, 152, 219, 0.4);
            border: 3px solid #fff;
            left: 7px;
            box-sizing: border-box;
        }

        /* A Cabine Móvel do Elevador */
        .cabine {
            width: 64px;
            height: 65px;
            background-color: #bdc3c7;
            border: 2px solid #7f8c8d;
            position: absolute;
            left: 10px;
            bottom: 15px;
            transition: bottom 1.2s ease-in-out;
            display: flex;
            z-index: 10;
        }
        .porta {
            width: 50%;
            height: 100%;
            background-color: #7f8c8d;
            border: 1px solid #95a5a6;
            transition: width 0.5s ease-in-out;
        }
        .interior-cabine {
            position: absolute;
            width: 100%;
            height: 100%;
            background-color: #f39c12;
            z-index: -1;
        }
    </style>
    <script>
        window.resizeTo(760, 570);

        var andarAtual = 0;
        var andarDestino = 0;
        var emMovimento = false;
        var filaAndares = [];
        
        // Cada andar na casa tem exatamente 99px de altura calculada
        var alturaAndar = 99; 

        function carregar() {
            atualizarVisor(andarAtual, "");
        }

        function chamarAndar(andar) {
            if (andar === andarAtual && !emMovimento) {
                abrirPortas();
                return;
            }
            
            if (!filaAndares.contains(andar) && andar !== andarAtual) {
                filaAndares.push(andar);
                document.getElementById("btn" + andar).className = "btn-andar chamado";
                if (!emMovimento) {
                    processarFila();
                }
            }
        }

        function processarFila() {
            if (filaAndares.length === 0) {
                emMovimento = false;
                atualizarVisor(andarAtual, "");
                return;
            }

            emMovimento = true;
            andarDestino = filaAndares.shift();
            moverElevador();
        }

        function moverElevador() {
            if (andarAtual < andarDestino) {
                atualizarVisor(andarAtual, "A SUBIR");
                andarAtual++;
                executarMovimento();
            } else if (andarAtual > andarDestino) {
                atualizarVisor(andarAtual, "A DESCER");
                andarAtual--;
                executarMovimento();
            } else {
                document.getElementById("btn" + andarAtual).className = "btn-andar";
                atualizarVisor(andarAtual, "CHEGOU");
                abrirPortas();
            }
        }

        function ejecutarMovimento() {
            var cabine = document.getElementById("cabine");
            // Cálculo exato para centrar a cabine nas janelas da casa
            cabine.style.bottom = (andarAtual * alturaAndar + 15) + "px";
            
            setTimeout(moverElevador, 1500);
        }

        function abrirPortas() {
            document.getElementById("pEsq").style.width = "0%";
            document.getElementById("pDir").style.width = "0%";
            setTimeout(fecharPortas, 2500);
        }

        function fecharPortas() {
            document.getElementById("pEsq").style.width = "50%";
            document.getElementById("pDir").style.width = "50%";
            setTimeout(processarFila, 600);
        }

        function atualizarVisor(andar, estado) {
            var nomeAndar = "";
            switch(andar) {
                case 0: nomeAndar = "PISO 0"; break;
                case 1: nomeAndar = "PISO 1"; break;
                case 2: nomeAndar = "PISO 2"; break;
                case 3: nomeAndar = "PISO 3"; break;
            }
            document.getElementById("txtVisor").innerHTML = nomeAndar + "<br><span style='font-size:14px;color:#e74c3c;'>" + estado + "</span>";
        }

        Array.prototype.contains = function(obj) {
            var i = this.length;
            while (i--) {
                if (this[i] === obj) { return true; }
            }
            return false;
        }
    </script>
</head>
<body onload="carregar()">

    <div class="container">
        <!-- Painel de Operação -->
        <div class="painel">
            <div class="visor" id="txtVisor">PISO 0</div>
            <div class="botoes-grid">
                <button id="btn3" class="btn-andar" onclick="chamarAndar(3)">3</button>
                <button id="btn2" class="btn-andar" onclick="chamarAndar(2)">2</button>
                <button id="btn1" class="btn-andar" onclick="chamarAndar(1)">1</button>
                <button id="btn0" class="btn-andar" onclick="chamarAndar(0)">0</button>
            </div>
            <p style="font-size: 11px; text-align: center; margin-top: 30px; color: #95a5a6;">Simulador Residencial HTA</p>
        </div>

        <!-- Cenário Gráfico da Casa -->
        <div class="cenario">
            <div class="telhado"></div>
            
            <div class="casa">
                <!-- Divisões Interiores -->
                <div class="divisao-andar" style="bottom: 297px;">Sótão / Quarto 2</div>
                <div class="divisao-andar" style="bottom: 198px;">Quarto Principal</div>

