<!DOCTYPE html>
<html>
<head>
    <title>Simulador de Metro HTA</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=9">
    
    <hta:application 
        id="oMetro"
        applicationname="SimuladorMetro"
        border="thin"
        caption="yes"
        showintaskbar="yes"
        singleinstance="yes"
        sysmenu="yes"
        windowstate="normal"
        scroll="no"
    >

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #1e272e;
            color: #ecf0f1;
            margin: 0;
            padding: 20px;
        }
        .janela-principal {
            width: 740px;
            background-color: #2c3e50;
            border: 4px solid #0f171e;
            border-radius: 8px;
            padding: 20px;
        }
        .painel-superior {
            margin-bottom: 20px;
            background-color: #1b2631;
            padding: 15px;
            border-radius: 6px;
        }
        .visor-led {
            width: 95%;
            height: 40px;
            background-color: #000;
            border: 2px solid #7f8c8d;
            border-radius: 4px;
            line-height: 40px;
            padding-left: 15px;
            font-family: monospace;
            font-size: 16px;
            color: #ff9f43;
            font-weight: bold;
            margin-bottom: 15px;
        }
        .mapa-linha {
            width: 100%;
            height: 50px;
            background-color: #2f3640;
            margin-bottom: 25px;
            position: relative;
            border-radius: 4px;
        }
        .linha-trilho {
            position: absolute;
            height: 6px;
            background-color: #3498db;
            left: 50px;
            right: 50px;
            top: 22px;
        }
        .btn-estacao {
            position: absolute;
            top: 12px;
            width: 100px;
            height: 26px;
            font-size: 11px;
            font-weight: bold;
            cursor: pointer;
        }
        .tunel {
            width: 100%;
            height: 140px;
            background-color: #111;
            border: 3px dashed #333;
            position: relative;
            border-radius: 6px;
            overflow: hidden;
            margin-bottom: 20px;
        }
        .plataforma-visual {
            position: absolute;
            width: 130px;
            height: 15px;
            background-color: #7f8c8d;
            bottom: 0;
            border-top: 3px solid #f1c40f;
        }
        .metro-carruagem {
            width: 180px;
            height: 75px;
            background-color: #dcdde1;
            border: 3px solid #7f8c8d;
            border-radius: 8px 8px 0 0;
            position: absolute;
            bottom: 5px;
            left: 20px;
            /* Transição compatível com IE9 */
            -ms-transition: left 3s ease-in-out;
            transition: left 3s ease-in-out;
        }
        .janela-metro {
            width: 35px;
            height: 25px;
            background-color: #34495e;
            border: 2px solid #7f8c8d;
            position: absolute;
            top: 12px;
            border-radius: 4px;
        }
        .porta-metro {
            width: 45px;
            height: 52px;
            background-color: #7f8c8d;
            position: absolute;
            bottom: 0;
            left: 68px;
            border: 1px solid #333;
        }
        .folha-porta {
            width: 50%;
            height: 100%;
            background-color: #b2bec3;
            float: left;
            -ms-transition: width 0.5s ease-in-out;
            transition: width 0.5s ease-in-out;
        }
        .btn-controlo {
            padding: 10px 20px;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            margin-right: 10px;
        }
    </style>

    <script>
        // Redimensionar a janela do HTA
        window.resizeTo(800, 560);

        var estacaoAtual = 0;
        var estacaoDestino = 0;
        var emViagem = false;
        var portasAbertas = false;
        var nomesEstacoes = ["Oriente", "Alvalade", "Rossio", "Cais Sodre"];

        // Devolve os pixéis exatos de cada paragem no túnel
        function obterDestinoPixel(index) {
            if (index == 0) return 20;
            if (index == 1) return 220;
            if (index == 2) return 420;
            if (index == 3) return 540;
            return 20;
        }

        function abrirPortas() {
            if (emViagem) return;
            document.getElementById("pEsq").style.width = "0%";
            document.getElementById("pDir").style.width = "0%";
            portasAbertas = true;
            document.getElementById("txtVisor").innerHTML = "Estacao: " + nomesEstacoes[estacaoAtual] + " - Portas Abertas";
        }

        function fecharPortas() {
            document.getElementById("pEsq").style.width = "50%";
            document.getElementById("pDir").style.width = "50%";
            portasAbertas = false;
            document.getElementById("txtVisor").innerHTML = "Estacao: " + nomesEstacoes[estacaoAtual] + " - Portas Fechadas";
        }

        function selecionarEstacao(index) {
            if (emViagem || index == estacaoAtual) return;
            
            estacaoDestino = index;
            document.getElementById("txtVisor").innerHTML = "Proxima Paragem Selecionada: " + nomesEstacoes[estacaoDestino];
            document.getElementById("btnPartida").disabled = false;
        }

        function iniciarMarcha() {
            if (emViagem || estacaoAtual == estacaoDestino) return;
            
            // Garantir que as portas fecham antes de andar
            fecharPortas();
            
            // Pequena pausa para as portas fecharem visualmente antes do arranque
            setTimeout(function() {
                emViagem = true;
                document.getElementById("btnPartida").disabled = true;
                document.getElementById("txtVisor").innerHTML = "Em viagem para " + nomesEstacoes[estacaoDestino] + "... 🚇";

                var comboio = document.getElementById("comboio");
                comboio.style.left = obterDestinoPixel(estacaoDestino) + "px";

                // Tempo fixo de viagem (3 segundos da transição CSS)
                setTimeout(chegadaEstacao, 3100);
            }, 600);
        }

        function chegadaEstacao() {
            estacaoAtual = estacaoDestino;
            emViagem = false;
            abrirPortas();
        }
    </script>
</head>
<body>

    <div class="janela-principal">
        <h2>Painel de Controlo do Metropolitano</h2>
        
        <div class="painel-superior">
            <div class="visor-led" id="txtVisor">Terminacao: Oriente. Portas Abertas.</div>
            
            <div style="margin-top: 10px;">
                <button class="btn-controlo" onclick="abrirPortas()">Abrir Portas</button>
                <button class="btn-controlo" onclick="fecharPortas()">Fechar Portas</button>
                <button id="btnPartida" class="btn-controlo" style="background-color: #2ecc71; color: #fff;" onclick="iniciarMarcha()" disabled>Iniciar Marcha ▶</button>
            </div>
        </div>

        <!-- Mapa de Linha baseado em botões físicos puros -->
        <div class="mapa-linha">
            <div class="linha-trilho"></div>
            <button class="btn-estacao" style="left: 30px;" onclick="selecionarEstacao(0)">1. Oriente</button>
            <button class="btn-estacao" style="left: 230px;" onclick="selecionarEstacao(1)">2. Alvalade</button>
            <button class="btn-estacao" style="left: 430px;" onclick="selecionarEstacao(2)">3. Rossio</button>
            <button class="btn-estacao" style="left: 610px;" onclick="selecionarEstacao(3)">4. Cais Sodre</button>
        </div>

        <!-- O Túnel Ferroviário -->
        <div class="tunel">
            <div class="plataforma-visual" style="left: 20px;"></div>
            <div class="plataforma-visual" style="left: 220px;"></div>
            <div class="plataforma-visual" style="left: 420px;"></div>
            <div class="plataforma-visual" style="left: 540px;"></div>

            <div id="comboio" class="metro-carruagem">
                <div class="janela-metro" style="left: 15px;"></div>
                <div class="janela-metro" style="left: 125px;"></div>
                
                <div class="porta-metro">
                    <div id="pEsq" class="folha-porta" style="width: 0%;"></div>
                    <div id="pDir" class="folha-porta" style="width: 50%;"></div>
                </div>
            </div>
        </div>
        
        <p style="font-size: 12px; color: #95a5a6; text-align: center;">Selecione a estação desejada no mapa cinzento e prima "Iniciar Marcha".</p>
    </div>

    <script>
        // Forçar o estado inicial correto das portas abertas graficamente
        document.getElementById("pEsq").style.width = "0%";
        document.getElementById("pDir").style.width = "0%";
        portasAbertas = true;
    </script>
</body>
</html>
