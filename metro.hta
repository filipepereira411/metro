<!DOCTYPE html>
<html>
<head>
    <title>Simulador de Metro HTA</title>
    <meta http-equiv="X-UA-Compatible" content="IE=9">
    <hta:application 
        id="oMetro"
        applicationname="SimuladorMetro"
        border="thin"
        caption="yes"
        showintaskbar="yes"
        singleinstance="yes"
        sysmenu="yes"
        windowstate="normal"
        scroll="no"
    >
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #1e272e;
            color: #ecf0f1;
            margin: 0;
            padding: 20px;
            user-select: none;
        }

        .janela-principal {
            width: 760px;
            background-color: #2c3e50;
            border: 4px solid #0f171e;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.7);
        }

        .painel-superior {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
            background-color: #1b2631;
            padding: 15px;
            border-radius: 6px;
            border: 2px solid #2c3e50;
        }

        .visor-led {
            width: 420px;
            height: 50px;
            background-color: #000;
            border: 2px solid #7f8c8d;
            border-radius: 4px;
            display: flex;
            align-items: center;
            padding-left: 15px;
            font-family: 'Courier New', Courier, monospace;
            font-size: 18px;
            color: #ff9f43;
            font-weight: bold;
            text-shadow: 0 0 8px #ff9f43;
        }

        .mapa-linha {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            height: 40px;
            background-color: #2f3640;
            margin-bottom: 25px;
            padding: 0 40px;
            box-sizing: border-box;
            position: relative;
            border-radius: 4px;
        }

        .linha-trilho {
            position: absolute;
            height: 6px;
            background-color: #3498db;
            left: 50px;
            right: 50px;
            top: 17px;
            z-index: 1;
        }

        .estacao-ponto {
            width: 16px;
            height: 16px;
            background-color: #7f8c8d;
            border: 3px solid #fff;
            border-radius: 50%;
            z-index: 2;
            position: relative;
            cursor: pointer;
            transition: background-color 0.3s, box-shadow 0.3s;
        }

        .estacao-ponto.ativa {
            background-color: #2ecc71;
            box-shadow: 0 0 10px #2ecc71;
        }

        .estacao-ponto.destino {
            background-color: #e74c3c;
            animation: piscar 0.6s infinite alternate;
        }

        .label-estacao {
            position: absolute;
            top: 22px;
            left: -30px;
            width: 80px;
            text-align: center;
            font-size: 11px;
            font-weight: bold;
            color: #dcdde1;
        }

        .tunel {
            width: 100%;
            height: 140px;
            background-color: #111;
            border: 3px dashed #333;
            position: relative;
            border-radius: 6px;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .plataforma-visual {
            position: absolute;
            width: 140px;
            height: 15px;
            background-color: #7f8c8d;
            bottom: 0;
            border-top: 3px solid #f1c40f;
            z-index: 3;
        }

        .metro-carruagem {
            width: 180px;
            height: 75px;
            background-color: #dcdde1;
            border: 3px solid #7f8c8d;
            border-radius: 8px 8px 0 0;
            position: absolute;
            bottom: 5px;
            left: 20px;
            transition: left 4s cubic-bezier(0.45, 0, 0.55, 1);
            z-index: 5;
        }

        .janela-metro {
            width: 35px;
            height: 25px;
            background-color: #34495e;
            border: 2px solid #7f8c8d;
            position: absolute;
            top: 12px;
            border-radius: 4px;
        }

        .porta-metro {
            width: 45px;
            height: 52px;
            background-color: #7f8c8d;
            position: absolute;
            bottom: 0;
            left: 68px;
            border: 1px solid #333;
            display: flex;
        }

        .folha-porta {
            width: 50%;
            height: 100%;
            background-color: #b2bec3;
            border: 1px solid #636e72;
            transition: width 0.8s ease-in-out;
        }

        .botoes-controlo {
            display: flex;
            gap: 15px;
        }

        .btn-metro {
            padding: 10px 20px;
            font-size: 14px;
            font-weight: bold;
            color: #fff;
            background-color: #34495e;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            box-shadow: 0 3px #2c3e50;
        }

        .btn-metro:active {
            transform: translateY(2px);
            box-shadow: 0 1px #2c3e50;
        }

        .btn-marcha {
            background-color: #2ecc71;
            box-shadow: 0 3px #27ae60;
        }

        @keyframes piscar {
            from { opacity: 1; }
            to { opacity: 0.3; }
        }
    </style>
    <script>
        window.resizeTo(820, 560);

        var estacaoAtual = 0;
        var estacaoDestino = 0;
        var emViagem = false;
        var portasAbertas = true;

        var nomesEstacoes = ["Oriente", "Alvalade", "Rossio", "Cais Sodré"];
        var posicoesEstacoes = [20, 235, 430, 640];

        function atualizarMapaVisual() {
            for (var i = 0; i < 4; i++) {
                var ponto = document.getElementById("ponto" + i);
                ponto.className = "estacao-ponto" + (i === estacaoAtual ? " ativa" : "");
            }

            if (estacaoDestino >= 0 && estacaoDestino < 4) {
                var destino = document.getElementById("ponto" + estacaoDestino);
                if (emViagem) {
                    destino.className = "estacao-ponto destino";
                }
            }
        }

        function selecionarEstacao(index) {
            if (emViagem || index === estacaoAtual) return;

            if (portasAbertas) {
                fecharPortas();
                setTimeout(function() {
                    prepararViagem(index);
                }, 700);
                return;
            }

            prepararViagem(index);
        }

        function prepararViagem(index) {
            estacaoDestino = index;
            atualizarMapaVisual();
            document.getElementById("ponto" + index).className = "estacao-ponto destino";
            document.getElementById("txtVisor").innerHTML = "Próxima Paragem: " + nomesEstacoes[estacaoDestino];
            document.getElementById("btnPartida").disabled = false;
        }

        function iniciarMarcha() {
            if (emViagem || estacaoAtual === estacaoDestino) return;

            emViagem = true;
            document.getElementById("btnPartida").disabled = true;
            document.getElementById("txtVisor").innerHTML = "Em viagem para " + nomesEstacoes[estacaoDestino] + "... 🚇";

            var carruagem = document.getElementById("comboio");
            var distancia = Math.abs(estacaoDestino - estacaoAtual);
            carruagem.style.transition = "left " + (distancia * 2.5 + 1.5) + "s cubic-bezier(0.45, 0, 0.55, 1)";
            carruagem.style.left = posicoesEstacoes[estacaoDestino] + "px";

            setTimeout(chegadaEstacao, (distancia * 2.5 + 1.5) * 1000);
        }

        function chegadaEstacao() {
            estacaoAtual = estacaoDestino;
            emViagem = false;

            document.getElementById("ponto" + estacaoAtual).className = "estacao-ponto ativa";
            document.getElementById("txtVisor").innerHTML = "Estação: " + nomesEstacoes[estacaoAtual] + " - Portas em operação";

            setTimeout(abrirPortas, 800);
        }

        function abrirPortas() {
            if (emViagem || portasAbertas) return;
            document.getElementById("pEsq").style.width = "0%";
            document.getElementById("pDir").style.width = "0%";
            portasAbertas = true;
            document.getElementById("txtVisor").innerHTML = "Estação: " + nomesEstacoes[estacaoAtual] + " - Portas abertas";
        }

        function fecharPortas() {
            if (emViagem || !portasAbertas) return;
            document.getElementById("pEsq").style.width = "50%";
            document.getElementById("pDir").style.width = "50%";
            portasAbertas = false;
            document.getElementById("txtVisor").innerHTML = "Estação: " + nomesEstacoes[estacaoAtual] + " - Portas fechadas";
        }

        function inicializar() {
            atualizarMapaVisual();
            document.getElementById("txtVisor").innerHTML = "Terminação: Oriente. Portas abertas.";
            document.getElementById("comboio").style.left = "20px";
        }

        window.onload = inicializar;
    </script>
</head>
<body>
    <div class="janela-principal">
        <h2>Painel de Controlo do Metropolitano</h2>

        <div class="painel-superior">
            <div class="visor-led" id="txtVisor">Terminação: Oriente. Portas Abertas.</div>
            <div class="botoes-controlo">
                <button class="btn-metro" onclick="abrirPortas()">Abrir Portas</button>
                <button class="btn-metro" onclick="fecharPortas()">Fechar Portas</button>
                <button id="btnPartida" class="btn-metro btn-marcha" onclick="iniciarMarcha()" disabled>Iniciar Marcha ▶</button>
            </div>
        </div>

        <div class="mapa-linha">
            <div class="linha-trilho"></div>

            <div id="ponto0" class="estacao-ponto ativa" onclick="selecionarEstacao(0)">
                <div class="label-estacao">Oriente</div>
            </div>
            <div id="ponto1" class="estacao-ponto" onclick="selecionarEstacao(1)">
                <div class="label-estacao">Alvalade</div>
            </div>
            <div id="ponto2" class="estacao-ponto" onclick="selecionarEstacao(2)">
                <div class="label-estacao">Rossio</div>
            </div>
            <div id="ponto3" class="estacao-ponto" onclick="selecionarEstacao(3)">
                <div class="label-estacao">Cais Sodré</div>
            </div>
        </div>

        <div class="tunel">
            <div class="plataforma-visual" style="left: 10px;"></div>
            <div class="plataforma-visual" style="left: 420px;"></div>

            <div id="comboio" class="metro-carruagem" style="left: 20px;">
                <div class="janela-metro" style="left: 10px;"></div>
                <div class="janela-metro" style="left: 55px;"></div>
                <div class="janela-metro" style="left: 100px;"></div>
                <div class="janela-metro" style="left: 145px;"></div>

                <div class="porta-metro" style="left: 65px;">
                    <div id="pEsq" class="folha-porta" style="width: 50%;"></div>
                    <div id="pDir" class="folha-porta" style="width: 50%;"></div>
                </div>

                <div class="porta-metro" style="left: 110px;">
                    <div id="pEsq2" class="folha-porta" style="width: 50%;"></div>
                    <div id="pDir2" class="folha-porta" style="width: 50%;"></div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
